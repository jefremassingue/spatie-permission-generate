{
    "name": "jefremassingue/spatie-permission-generate",
    "description": "Package for generate permissions",
    "keywords": [
        "spatie permission generate",
        "spatie-permission-generate",
        "jefremassingue",
        "spatie-permission",
        "generate"
    ],
    "type": "library",
    "homepage": "https://github.com/jefremassingue/spatie-permission-generate",
    "support": {
        "issues": "https://github.com/jefremassingue/spatie-permission-generate/issues",
        "source": "https://github.com/jefremassingue/spatie-permission-generate"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Jefre Massingue",
            "email": "jefremassingue.jm@gmail.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Jefre\\SpatiePermissionGenerate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jefre\\SpatiePermissionGenerate\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-filter src --coverage-html coverage"
    },
    "require": {
        "php": ">=7.3",
        "spatie/laravel-permission": "^4.2|^5.0|^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.0|^10.0|^11.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jefre\\SpatiePermissionGenerate\\Providers\\ServiceProvider"
            ],
            "aliases": {
                "SpatiePermissionGenerate": "Jefre\\SpatiePermissionGenerate\\Facades\\SpatiePermissionGenerate"
            }
        }
    }
}
